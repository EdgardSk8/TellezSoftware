{
  "name": "tellezsoftware",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --config wrangler.local.jsonc --port 8788",
    "dev:stack": "npm run db:migrate:local && npm run dev:pages",
    "db:migrate:local": "wrangler d1 migrations apply tellezsoftware-local --local --config wrangler.local.jsonc",
    "infra:plan": "node scripts/provision-cloudflare.mjs",
    "infra:provision": "node scripts/provision-cloudflare.mjs --apply",
    "infra:check": "node scripts/provision-cloudflare.mjs --check",
    "build": "tsc -b && tsc --noEmit -p tsconfig.worker.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.161.0"
  }
}
