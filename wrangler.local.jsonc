{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tellezsoftware-local",
  "compatibility_date": "2026-11-12",
  // This all-zero D1 identifier is only for Wrangler's local emulator.
  // Production deployments must use wrangler.jsonc generated by provisioning.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tellezsoftware-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tellezsoftware-local-files"
    }
  ]
}
